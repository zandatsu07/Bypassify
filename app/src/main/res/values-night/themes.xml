<resources>
    <style name="ThemeOverlay.BypassCharging.PureBlack" parent="">
        <item name="android:colorBackground">#000000</item>
        <item name="colorSurface">#000000</item>
        <item name="colorSurfaceContainerLowest">#000000</item>
        <item name="colorSurfaceContainerLow">#0A0A0A</item>
        <item name="colorSurfaceContainer">#101010</item>
        <item name="colorSurfaceContainerHigh">#171717</item>
        <item name="colorSurfaceContainerHighest">#1E1E1E</item>
    </style>

    <!-- Also applies black on devices without Material You -->
    <style name="Theme.BypassCharging" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:colorBackground">#000000</item>
        <item name="colorSurface">#000000</item>
        <item name="colorSurfaceContainerLowest">#000000</item>
        <item name="colorSurfaceContainerLow">#0A0A0A</item>
        <item name="colorSurfaceContainer">#101010</item>
        <item name="colorSurfaceContainerHigh">#171717</item>
        <item name="colorSurfaceContainerHighest">#1E1E1E</item>
        <item name="android:statusBarColor">@android:color/black</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>
